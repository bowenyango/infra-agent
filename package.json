{
  "name": "infra-agent",
  "version": "0.1.0",
  "private": true,
  "description": "IaC context compiler CLI for Terraform, Pulumi, and Helm repositories.",
  "type": "module",
  "bin": {
    "infra-agent": "./bin/infra-agent.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "AGENTS.md",
    "README.md",
    "docs/AGENT_RULES.md",
    "docs/CLAUDE_CODE_AGENT_PATTERNS.md",
    "docs/ROADMAP.md",
    "docs/TESTING.md"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types ./src/cli/main.ts",
    "agent": "node --experimental-strip-types ./src/cli/main.ts agent",
    "inspect": "node --experimental-strip-types ./src/cli/main.ts inspect",
    "validate": "node --experimental-strip-types ./src/cli/main.ts validate",
    "run": "node --experimental-strip-types ./src/cli/main.ts run",
    "lint": "node ./scripts/lint.mjs",
    "test:structure": "node ./scripts/check-test-structure.mjs",
    "test:unit": "node --experimental-strip-types ./test/run-unit.mjs",
    "test:integration": "node --experimental-strip-types ./test/run-integration.mjs",
    "test:contract": "node --experimental-strip-types ./test/run-contract.mjs",
    "test:all": "node --experimental-strip-types ./test/run-all.mjs",
    "test:isolated": "node --experimental-strip-types ./test/run-isolated.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/types/**/*.ts' --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=90 ./test/run-all.mjs",
    "test:focused": "node --experimental-strip-types",
    "test": "npm run test:structure && npm run test:all",
    "smoke": "node --experimental-strip-types ./scripts/smoke.mjs",
    "e2e": "node --experimental-strip-types ./scripts/e2e.mjs",
    "package:check": "npm_config_cache=/tmp/infra-agent-npm-cache npm pack --dry-run --json",
    "verify": "npm run lint && npm run test:structure && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:isolated && npm run smoke && npm run e2e && npm run test:coverage && npm run package:check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
